--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1476,11 +1476,11 @@ int hostapd_dfs_radar_detected(struct hostapd_iface *iface, int freq,
 
 	hostapd_ubus_notify_radar_detected(iface, freq, chan_width, cf1, cf2);
 
-	iface->radar_detected = true;
-
 	/* Proceed only if DFS is not offloaded to the driver */
-	if (iface->drv_flags & WPA_DRIVER_FLAGS_DFS_OFFLOAD)
+	if (iface->drv_flags & WPA_DRIVER_FLAGS_DFS_OFFLOAD) {
+		iface->radar_detected = true;
 		return 0;
+	}
 
 	if (!iface->conf->ieee80211h)
 		return 0;
@@ -1497,6 +1497,8 @@ int hostapd_dfs_radar_detected(struct hostapd_iface *iface, int freq,
 			return 0;
 	}
 
+	iface->radar_detected = true;
+
 	if (hostapd_dfs_background_start_channel_switch(iface, freq)) {
 		/* Radar detected while operating, switch the channel. */
 		return hostapd_dfs_start_channel_switch(iface);
@@ -1569,8 +1571,19 @@ int hostapd_dfs_start_cac(struct hostapd_iface *iface, int freq,
 			  int ht_enabled, int chan_offset, int chan_width,
 			  int cf1, int cf2)
 {
+	bool offchannel_cac;
+
+	/* Off-channel CAC must not restart the enabled lower 80 MHz AP. */
+	offchannel_cac = iface->state == HAPD_IFACE_ENABLED &&
+		iface->conf->channel >= 36 && iface->conf->channel <= 48 &&
+		hostapd_get_oper_chwidth(iface->conf) ==
+			CONF_OPER_CHWIDTH_80MHZ &&
+		hostapd_get_oper_centr_freq_seg0_idx(iface->conf) == 42 &&
+		chan_width == CHAN_WIDTH_80 && cf1 == 5290 &&
+		freq >= 5260 && freq <= 5320;
+
 	if (hostapd_dfs_is_background_event(iface, freq)) {
 		iface->radar_background.cac_started = 1;
-	} else {
+	} else if (!offchannel_cac) {
 		/* This is called when the driver indicates that an offloaded
 		 * DFS has started CAC. radar_detected might be set for previous
 		 * DFS channel. Clear it for this new CAC process. */
@@ -1591,8 +1604,9 @@ int hostapd_dfs_start_cac(struct hostapd_iface *iface, int freq,
 		"freq=%d chan=%d chan_offset=%d width=%d seg0=%d "
 		"seg1=%d cac_time=%ds%s",
 		freq, (freq - 5000) / 5, chan_offset, chan_width, cf1, cf2,
 		iface->dfs_cac_ms / 1000,
-		hostapd_dfs_is_background_event(iface, freq) ?
+		(hostapd_dfs_is_background_event(iface, freq) ||
+		 offchannel_cac) ?
 		" (background)" : "");
 
 	os_get_reltime(&iface->dfs_cac_start);
