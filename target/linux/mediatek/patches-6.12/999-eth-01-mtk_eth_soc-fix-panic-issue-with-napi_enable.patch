---
[v1] net: ethernet: mtk_eth_soc: fix panic with napi_enable in mtk_open

Fix kernel panic during late ETH initialization when mtk_open is called before
netif_napi_add completes. This patch reorders NAPI initialization to ensure proper
setup before interface opening, preventing race conditions.
---
v1: Fix panic with napi_enable in mtk_open.
---

From 54298b484f6bd28a33901d2b3562dc536c7807e8 Mon Sep 17 00:00:00 2001
From: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Date: Thu, 18 Sep 2025 17:26:48 +0800
Subject: [PATCH] net: ethernet: mtk_eth_soc: fix panic issue with napi_enable 
 in mtk_open

In some scenarios, the ETH may be initialized late, making it very
close to when mtk_open is called. This could lead to a kernel panic at
netif_napi_enable because the ETH driver does not call netif_napi_add().

Signed-off-by: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4770,6 +4770,19 @@ static void mtk_pending_work(struct work
 	rtnl_unlock();
 }
 
+static void mtk_napi_del(struct mtk_eth *eth)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(eth->tx_napi); i++)
+		if (eth->tx_napi[i].napi.dev)
+			netif_napi_del(&eth->tx_napi[i].napi);
+
+	for (i = 0; i < ARRAY_SIZE(eth->rx_napi); i++)
+		if (eth->rx_napi[i].napi.dev)
+			netif_napi_del(&eth->rx_napi[i].napi);
+}
+
 static int mtk_free_dev(struct mtk_eth *eth)
 {
 	int i;
@@ -5731,7 +5744,7 @@ static int mtk_probe(struct platform_dev
 	if (!eth->dummy_dev) {
 		err = -ENOMEM;
 		dev_err(eth->dev, "failed to allocated dummy device\n");
-		goto err_unreg_netdev;
+		goto err_deinit_ppe;
 	}
 	eth->dummy_dev->threaded = 1;
 	strcpy(eth->dummy_dev->name, "mtk_eth");
@@ -5767,10 +5780,9 @@ err_deinit_ppe:
 	 */
 	cancel_work_sync(&eth->pending_work);
 	if (eth->dummy_dev) {
-		netif_napi_del(&eth->tx_napi);
-		netif_napi_del(&eth->rx_napi);
 		free_netdev(eth->dummy_dev);
 	}
+	mtk_napi_del(eth);
 	mtk_ppe_deinit(eth);
 	mtk_mdio_cleanup(eth);
 err_free_dev:
@@ -5808,8 +5820,7 @@ static void mtk_remove(struct platform_d
 	mtk_wed_exit();
 	mtk_hw_deinit(eth);
 
-	netif_napi_del(&eth->tx_napi);
-	netif_napi_del(&eth->rx_napi);
+	mtk_napi_del(eth);
 	mtk_cleanup(eth);
 	free_netdev(eth->dummy_dev);
 	mtk_mdio_cleanup(eth);
