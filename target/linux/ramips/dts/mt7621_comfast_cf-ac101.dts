#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "comfast,cf-ac101", "mediatek,mt7621-soc";
	model = "COMFAST CF-AC101";

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x10000000>;  // 256 MB
	};

	chosen {
		bootargs = "console=ttyS0,115200 maxcpus=2";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system: system {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};

		wdt {
			label = "orange:wdt";
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
		};

		port0 {
			label = "orange:lan1";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		port1 {
			label = "orange:lan2";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		port2 {
			label = "orange:lan3";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		port3 {
			label = "orange:lan4";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};

		port4 {
			label = "orange:wan";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
	};
};

&pcie {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
		m25p,fast-read;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0xe00>;
					};

					eeprom_factory_8000: eeprom@8000 {
						reg = <0x8000 0xe00>;
					};

					macaddr_factory_4: macaddr@4 {
						compatible = "mac-base";
						reg = <0x4 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xf70000>;
			};

			partition@fc0000 {
				label = "configs";
				reg = <0xfc0000 0x40000>;
				read-only;
			};

			partition@1000000 {
				label = "reserve";
				reg = <0x1000000 0x1000000>;
				read-only;
			};
		};
	};
};

&ethernet {
        pinctrl-0 = <&mdio_pins>, <&rgmii2_pins>;
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_4 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "disabled";
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};

		port@3 {
			status = "okay";
			label = "lan4";
		};

		port@4 {
			status = "okay";
			label = "wan";
			nvmem-cells = <&macaddr_factory_4 1>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "wdt", "uart3", "jtag";
		function = "gpio";
	};
};
